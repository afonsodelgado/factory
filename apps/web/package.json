{
  "name": "@factory/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "lint": "prettier --check .",
    "typecheck": "astro sync && astro check --noSync",
    "test": "node --test tests/frames.test.ts && playwright test",
    "dev": "astro dev --host 127.0.0.1 --port 4321 --ignore-lock",
    "preview": "astro preview --host 127.0.0.1 --port 4321 --ignore-lock",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
