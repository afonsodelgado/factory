---
import {
  DEFAULT_PLATFORM,
  commandHtml,
  commandLines,
  type CommandId,
} from "../lib/commands.ts";

interface Props {
  command: CommandId;
  label: string;
  title?: string;
  cursor?: boolean;
}

const { command, label, title, cursor = false } = Astro.props;
const code = `<code data-code="${command}">${commandHtml(commandLines(command, DEFAULT_PLATFORM))}</code>`;
const shell = cursor
  ? `${code}<span class="cursor" data-cursor aria-hidden="true"></span>`
  : code;
---

{title ? (
  <div class="win full">
    <div class="bar">
      <span class="lights" aria-hidden="true">
        <i />
        <i />
        <i />
      </span>
      <span class="wt">{title}</span>
      <button
        class="copy"
        type="button"
        data-copy={command}
        aria-label={label}
        hidden
      >
        <i class="ic" data-n="&#xf0c5;" aria-hidden="true" />
        <span class="copy-label">copy</span>
      </button>
    </div>
    <pre class="shell" set:html={shell} />
  </div>
) : (
  <div class="cmd">
    <pre class="shell" set:html={shell} />
    <button
      class="copy"
      type="button"
      data-copy={command}
      aria-label={label}
      hidden
    >
      <i class="ic" data-n="&#xf0c5;" aria-hidden="true" />
      <span class="copy-label">copy</span>
    </button>
  </div>
)}
