{
  "SessionStart": [
    { "matcher": "startup|resume|clear|compact|fork", "hooks": [{ "type": "command", "command": "factory-tui hook" }] }
  ],
  "UserPromptSubmit": [
    { "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ],
  "PreToolUse": [
    { "matcher": "*", "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ],
  "PermissionRequest": [
    { "matcher": "*", "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ],
  "Notification": [
    { "matcher": "permission_prompt|idle_prompt", "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ],
  "Stop": [
    { "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ],
  "StopFailure": [
    { "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ],
  "SessionEnd": [
    { "hooks": [{ "type": "command", "command": "factory-tui hook", "async": true }] }
  ]
}
