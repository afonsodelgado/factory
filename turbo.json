{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.*",
        "!.astro/**",
        "!dist/**",
        "!build/**",
        "!test-results/**",
        "!playwright-report/**",
        "!coverage/**"
      ],
      "env": ["SITE_URL"],
      "outputs": ["dist/**", "build/**", ".astro/**"]
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.*",
        "!.astro/**",
        "!dist/**",
        "!build/**",
        "!test-results/**",
        "!playwright-report/**",
        "!coverage/**"
      ],
      "env": ["SITE_URL"],
      "outputs": [".astro/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.*",
        "!.astro/**",
        "!dist/**",
        "!build/**",
        "!test-results/**",
        "!playwright-report/**",
        "!coverage/**"
      ],
      "env": ["SITE_URL"],
      "outputs": ["test-results/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
